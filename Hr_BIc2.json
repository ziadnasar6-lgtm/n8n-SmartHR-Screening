      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "=You are an expert HR Specialist and Applicant Tracking System (ATS) evaluator. \nYour task is to analyze the provided CV text and evaluate it objectively for the target job role.\n\n### INSTRUCTIONS:\n1. Carefully read and analyze the CV text provided below.\n2. Evaluate the candidate based on relevant skills, practical experience, tools, and overall clarity.\n3. Calculate an overall match score as an integer percentage from 0 to 100.\n4. Identify key strengths and main areas for improvement (weaknesses).\n5. Output MUST be ONLY a single valid JSON object. Do NOT include any markdown formatting, preambles, introductory text, or closing notes.\n\n### OUTPUT JSON FORMAT:\n{\n  \"score\": 0,\n  \"strengths\": [\n    \"Point 1\",\n    \"Point 2\",\n    \"Point 3\"\n  ],\n  \"weaknesses\": [\n    \"Point 1\",\n    \"Point 2\"\n  ]\n}\n\n### INPUT CV TEXT:\n{{ $json.text }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -1520,
        -896
      ],
      "id": "eaa831fd-c0bf-4166-b98d-0fc1eb483984",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "llama3.2:3b",
        "options": {
          "keepAlive": "1h"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -1520,
        -592
      ],
      "id": "e6297931-c825-41f1-ab38-c3614e1bf4b7",
      "name": "Ollama Chat Model",
      "credentials": {
        "ollamaApi": {
          "id": "gjFRQLOqRu6k3Fz8",
          "name": "Ollama account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.output || \"\";\n\n// 1. تنظيف النص الأساسي\nraw = raw.replace(/```json|```/g, \"\").trim();\n\n// 2. استخراج الـ Object فقط\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\n\nif (start !== -1 && end !== -1) {\n  raw = raw.substring(start, end + 1);\n}\n\nlet score = 0;\nlet strengths = [];\nlet weaknesses = [];\n\ntry {\n  // محاولة القراءة المباشرة\n  const parsed = JSON.parse(raw);\n  score = parsed.score || 0;\n  strengths = parsed.strengths || [];\n  weaknesses = parsed.weaknesses || [];\n} catch (e) {\n  // استخراج القيم بـ Regex لو الـ JSON مكسور\n  const scoreMatch = raw.match(/\"score\"\\s*:\\s*(\\d+)/);\n  if (scoreMatch) score = parseInt(scoreMatch[1]);\n\n  const strengthsMatch = raw.match(/\"strengths\"\\s*:\\s*\\[([\\s\\S]*?)\\]\\s*,/);\n  if (strengthsMatch) {\n    strengths = strengthsMatch[1]\n      .split(/\",\\s*\"|\\n/)\n      .map(s => s.replace(/[\"\\\\]/g, '').trim())\n      .filter(Boolean);\n  }\n\n  const weaknessesMatch = raw.match(/\"weaknesses\"\\s*:\\s*\\[([\\s\\S]*?)\\]/);\n  if (weaknessesMatch) {\n    weaknesses = weaknessesMatch[1]\n      .split(/\",\\s*\"|\\n/)\n      .map(s => s.replace(/[\"\\\\]/g, '').trim())\n      .filter(Boolean);\n  }\n}\n\nreturn {\n  score: Number(score),\n  strengths: Array.isArray(strengths) ? strengths.join('\\n• ') : strengths,\n  weaknesses: Array.isArray(weaknesses) ? weaknesses.join('\\n• ') : weaknesses\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
